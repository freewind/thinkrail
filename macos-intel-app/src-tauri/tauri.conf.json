{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ThinkRail",
	"version": "0.0.0",
	"identifier": "ai.thinkrail.app.intel",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "ThinkRail",
				"width": 1440,
				"height": 900,
				"visible": false,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/thinkrail"],
		"macOS": {
			"minimumSystemVersion": "14.0"
		}
	}
}
